  "info": {
    "_postman_id": "02030094-0a30-4a0a-aee0-8a00c306dd6f",
    "name": "Steelcase RoomWizard Bookings Status API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Steelcase RoomWizard API provides programmatic access to conference room scheduling and reservation management. Using HTTP GET and POST requests, developers can retrieve room bookings, create reservations, check room availability, and manage meeting information. The API supports integration with enterprise calendaring systems including Microsoft Exchange, Office 365, and Google Calendar via the RoomWizard connector. The API is hosted on the local network where the RoomWizard connector is installed.\n\nContact Support:\n Name: Steelcase Tech Support",
      "type": "text/plain"
    }
